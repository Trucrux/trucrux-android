From 020b4b5888631068ce191a4ebe51f2d59699a354 Mon Sep 17 00:00:00 2001
From: shindesaahil <sahil.shinde@trunexa.com>
Date: Sun, 18 Aug 2024 11:00:30 +0530
Subject: [PATCH] usb hal: Use vendor.typec.legacy property for legacy type c

- For some boards that doesn't have Type C PD option, use property to
fix the role and pd option.
---
 usb/Usb.cpp | 8 +++++++-
 usb/Usb.h   | 3 ++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/usb/Usb.cpp b/usb/Usb.cpp
index c68d0921..6a5d2aa1 100644
--- a/usb/Usb.cpp
+++ b/usb/Usb.cpp
@@ -514,6 +514,12 @@ Status getTypeCPortNamesHelper(std::unordered_map<std::string, bool> *names) {
   DIR *dp;
   bool has_typec_port = false;
 
+  /* Enable Typ USB Legacy Support via vendor.typec.legacy property */
+  if (property_get_bool("vendor.typec.legacy", false)) {
+    ALOGE("Force Legacy device enabled");
+    return Status::ERROR;
+  }
+
   dp = opendir("/sys/class/typec");
   if (dp != NULL) {
     struct dirent *ep;
@@ -1010,4 +1016,4 @@ void Usb::cmdDumpDevice(int fd, const hidl_vec<hidl_string>& options) {
 }  // namespace V1_3
 }  // namespace usb
 }  // namespace hardware
-}  // namespace android
\ No newline at end of file
+}  // namespace android
diff --git a/usb/Usb.h b/usb/Usb.h
index 0ffb5680..299e3c38 100644
--- a/usb/Usb.h
+++ b/usb/Usb.h
@@ -24,6 +24,7 @@
 #include <android/hardware/usb/1.2/IUsbCallback.h>
 #include <android/hardware/usb/1.2/types.h>
 #include <android/hardware/usb/1.3/IUsb.h>
+#include <cutils/properties.h>
 #include <hidl/Status.h>
 #include <utils/Log.h>
 
@@ -102,4 +103,4 @@ struct Usb : public IUsb {
 }  // namespace hardware
 }  // namespace android
 
-#endif  // ANDROID_HARDWARE_USB_V1_3_USB_H
\ No newline at end of file
+#endif  // ANDROID_HARDWARE_USB_V1_3_USB_H
-- 
2.34.1

